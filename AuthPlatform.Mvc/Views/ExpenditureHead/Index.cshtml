@model List<ExpenditureHeadViewModel>

@{
    ViewData["Title"] = "Expenditure Heads";
}

<div class="container-fluid mt-4">

@*     @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    } *@

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <h5 class="mb-0">Expenditure Heads</h5>

            <a class="btn btn-primary btn-sm"
               asp-controller="ExpenditureHead"
               asp-action="Create">
                Create New
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="expenditureHeadTable"
                       class="table table-bordered table-striped align-middle nowrap w-100">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ExpenditureHeadId</td>
                                <td>@item.ExpenditureHeadName</td>
                                <td>@item.Description</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-warning btn-sm"
                                       asp-controller="ExpenditureHead"
                                       asp-action="Edit"
                                       asp-route-id="@item.ExpenditureHeadId">
                                        Edit
                                    </a>

                                    <form asp-controller="ExpenditureHead"
                                          asp-action="Delete"
                                          asp-route-id="@item.ExpenditureHeadId"
                                          method="post"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure?')">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expenditureHeadTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                searching: true,
                autoWidth: false
            });
        });
    </script>
}