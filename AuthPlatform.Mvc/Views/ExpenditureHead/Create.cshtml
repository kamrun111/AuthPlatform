@model ExpenditureHeadViewModel

@{
    ViewData["Title"] = "Create Expenditure Head";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        Create Expenditure Head
                    </h5>
                </div>

                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="ExpenditureHead"
                          asp-action="Create"
                          method="post">

                        <div class="mb-3">

                            <label asp-for="ExpenditureHeadName"
                                   class="form-label fw-semibold">

                                Name

                            </label>

                            <input asp-for="ExpenditureHeadName"
                                   class="form-control"
                                   placeholder="Enter expenditure head name" />

                            <span asp-validation-for="ExpenditureHeadName"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter description"></textarea>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   checked />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Active

                            </label>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                Save

                            </button>

                            <a class="btn btn-outline-secondary"
                               asp-controller="ExpenditureHead"
                               asp-action="Index">

                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}