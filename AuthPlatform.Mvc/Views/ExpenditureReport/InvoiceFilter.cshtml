@model AuthPlatform.Mvc.Models.Expenditures.ExpenditureInvoiceFilterViewModel

@{
    ViewData["Title"] = "Invoice Filter Print";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Invoice Filter Print</h5>
        </div>

        <div class="card-body">

            <form id="filterForm">

                <div class="row mb-3">

                    <div class="col-md-4">
                        <label class="form-label">Start Date</label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">End Date</label>
                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Expenditure Head</label>

                        <select asp-for="ExpenditureHeadId"
                                asp-items="Model.ExpenditureHeads"
                                class="form-select">

                            <option value="">All Heads</option>

                        </select>
                    </div>

                </div>

                <button type="button"
                        class="btn btn-success"
                        onclick="previewReport()">
                    Preview Report
                </button>

                <a asp-controller="ExpenditureInvoice"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Invoice Filter Report</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body p-0">
                <iframe id="reportFrame"
                        width="100%"
                        height="700px"
                        style="border:none;">
                </iframe>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewReport() {
            const startDate = document.getElementById('StartDate').value;
            const endDate = document.getElementById('EndDate').value;
            const expenditureHeadId = document.getElementById('ExpenditureHeadId').value;

            if (!startDate || !endDate) {
                alert('Please select start date and end date.');
                return;
            }

            let url = '/ExpenditureReport/InvoiceFilterPrint'
                + '?startDate=' + encodeURIComponent(startDate)
                + '&endDate=' + encodeURIComponent(endDate);

            if (expenditureHeadId) {
                url += '&expenditureHeadId=' + encodeURIComponent(expenditureHeadId);
            }

            $('#reportFrame').attr('src', url);
            $('#reportModal').modal('show');
        }
    </script>
}