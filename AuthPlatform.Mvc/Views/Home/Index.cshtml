@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <div class="card shadow-sm mb-4">
                <div class="card-body text-center py-4">

                    <h3 class="mb-3">
                        Welcome to AuthPlatform
                    </h3>

                    <p class="text-muted mb-0">
                        Enterprise authentication, authorization, expenditure management, and reporting platform.
                    </p>

                </div>
            </div>

        </div>

    </div>

    <div class="row justify-content-end mt-5">

        <div class="col-auto">

            <div class="card border-warning shadow-sm" style="width: 320px;">

                <div class="card-header bg-warning text-dark py-2 text-center">
                    <h6 class="mb-0">
                        Test Credentials
                    </h6>
                </div>

                <div class="card-body p-2">

                    <div class="table-responsive">

                        <table class="table table-bordered table-sm align-middle text-center mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Username</th>
                                    <th>Password</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <strong>Admin</strong>
                                    </td>

                                    <td>
                                        <code>admin</code>
                                    </td>

                                    <td>
                                        <code>Admin@123</code>
                                    </td>

                                </tr>

                                <tr>
                                    <td>
                                        <strong>TestUser</strong>
                                    </td>

                                    <td>
                                        <code>TestUser</code>
                                    </td>

                                    <td>
                                        <code>Admin@123</code>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <div class="text-center mt-2">

                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-dark btn-sm">

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>